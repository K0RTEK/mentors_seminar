      "status": "FINISHED",
      "focus": true,
      "$$hashKey": "object:10922"
    },
    {
      "text": "%spark.pyspark\nwin = Window.partitionBy(\"city\", \"product_id\", \"product_name\")\ntop_2_win = Window.partitionBy(\"city\").orderBy(\"revenue_sum\")",
      "user": "anonymous",
      "dateUpdated": "2026-04-24T00:44:11+0000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
