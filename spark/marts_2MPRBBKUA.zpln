{
  "paragraphs": [
    {
      "text": "%spark.pyspark from pyspark.sql import functions as F, Window\nusers = spark.createDataFrame(\n    [ (\"u1\", \"Berlin\"),\n    (\"u2\", \"Berlin\"),\n    (\"u3\", \"Munich\"),\n    (\"u4\", \"Hamburg\"), ],\n    [\"user_id\", \"city\"] \n)\norders = spark.createDataFrame(\n    [ (\"o1\", \"u1\", \"p1\", 2, 10.0),\n    (\"o2\", \"u1\", \"p2\", 1, 30.0),\n    (\"o3\", \"u2\", \"p1\", 1, 10.0),\n    (\"o4\", \"u2\", \"p3\", 5, 7.0),\n    (\"o5\", \"u3\", \"p2\", 3, 30.0),\n    (\"o6\", \"u3\", \"p3\", 1, 7.0),\n    (\"o7\", \"u4\", \"p1\", 10, 10.0), ],\n    [\"order_id\", \"user_id\", \"product_id\", \"qty\", \"price\"] \n)\nproducts = spark.createDataFrame(\n    [ (\"p1\", \"Ring VOLA\"),\n    (\"p2\", \"Ring POROG\"),\n    (\"p3\", \"Ring TISHINA\"), ],\n    [\"product_id\", \"product_name\"] \n)",
      "user": "anonymous",
      "dateUpdated": "2026-04-24T00:44:10+0000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionKey": "TAB",
