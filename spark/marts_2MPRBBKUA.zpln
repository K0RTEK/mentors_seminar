    {
      "text": "%spark.pyspark\nmart_city_top_products = users \\\n    .join(orders, on=\"user_id\", how=\"inner\") \\\n    .join(products, on=\"product_id\", how=\"inner\") \\\n    .withColumn(\"revenue\", F.col(\"qty\") * F.col(\"price\")) \\\n    .withColumn(\"orders_cnt\", F.count(\"*\").over(win)) \\\n    .withColumn(\"qty_sum\", F.sum(\"qty\").over(win)) \\\n    .withColumn(\"revenue_sum\", F.sum(\"revenue\").over(win)) \\\n    .withColumn(\"top_revenuesum_by_city\", F.dense_rank().over(top_2_win)) \\\n    .filter(F.col(\"top_revenuesum_by_city\") == 2)",
      "user": "anonymous",
      "dateUpdated": "2026-04-24T00:44:31+0000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
